# cryoFIFA SNR-sweep reconstructions, pre-aligned to ground truth.
# open in ChimeraX:  chimerax snr_montage.cxc
set bgColor white
open snr005.mrc
open snr01.mrc
open snr02.mrc
open snr03.mrc
open snr04.mrc
open snr05.mrc
open ground_truth.mrc
volume #1 level 1.2987 color tan style surface
volume #2 level 1.3724 color tan style surface
volume #3 level 1.7003 color tan style surface
volume #4 level 1.5924 color tan style surface
volume #5 level 1.5599 color tan style surface
volume #6 level 1.5520 color tan style surface
volume #7 level 0.3176 color cornflower blue style surface
lighting soft
graphics silhouettes true width 1.2
tile
# then:  save montage.png width 3200 supersample 3
