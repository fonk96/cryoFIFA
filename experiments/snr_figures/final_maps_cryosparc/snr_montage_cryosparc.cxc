# cryoSPARC ab-initio SNR sweep, aligned to ground truth. reconstructions tan, GT blue, GT at right.
# open in ChimeraX:  chimerax snr_montage_cryosparc.cxc
set bgColor white
open cs_snr05.mrc
open cs_snr1.mrc
open cs_snr2.mrc
open cs_snr3.mrc
open cs_snr4.mrc
open cs_snr5.mrc
open ground_truth.mrc
volume #1 level 0.2510 color #d1c8b4 style surface   # cs_snr05
volume #2 level 0.1987 color #d1c8b4 style surface   # cs_snr1
volume #3 level 0.3693 color #d1c8b4 style surface   # cs_snr2
volume #4 level 0.3830 color #d1c8b4 style surface   # cs_snr3
volume #5 level 0.3940 color #d1c8b4 style surface   # cs_snr4
volume #6 level 0.3996 color #d1c8b4 style surface   # cs_snr5
volume #7 level 0.3176 color #9ebfdb style surface   # ground_truth
lighting soft
graphics silhouettes true width 1.2
tile columns 7 spacingFactor 0.15
# then:  save montage_cryosparc.png width 3600 supersample 3
