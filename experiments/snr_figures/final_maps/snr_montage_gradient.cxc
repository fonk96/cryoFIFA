# cryoFIFA SNR sweep - single-hue (Blues) gradient by SNR, ground truth (gold) at right.
# open in ChimeraX:  chimerax snr_montage_gradient.cxc
set bgColor white
open snr005.mrc
open snr01.mrc
open snr02.mrc
open snr03.mrc
open snr04.mrc
open snr05.mrc
open ground_truth.mrc
volume #1 level 1.2987 color #9cc9e1 style surface   # SNR 0.05
volume #2 level 1.3724 color #6dafd7 style surface   # SNR 0.1
volume #3 level 1.7003 color #4896c8 style surface   # SNR 0.2
volume #4 level 1.5924 color #2979b9 style surface   # SNR 0.3
volume #5 level 1.5599 color #0f5aa3 style surface   # SNR 0.4
volume #6 level 1.5520 color #083c7d style surface   # SNR 0.5
volume #7 level 0.3176 color #d99e1a style surface   # Ground truth
lighting soft
graphics silhouettes true width 1.2
tile columns 7 spacingFactor 0.15
# then:  save montage_gradient.png width 3600 supersample 3
